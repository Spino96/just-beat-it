// Regole di sicurezza Firestore per il progetto "just-beat-it-76154" (app Beat Yourself)
//
// COME PUBBLICARLE (va fatto a mano, non posso farlo io da qui):
// 1. Vai su https://console.firebase.google.com/ → progetto "just-beat-it-76154"
// 2. Firestore Database → scheda "Regole"
// 3. Incolla questo intero file al posto delle regole esistenti
// 4. Premi "Pubblica"
//
// Cosa fanno:
// - Ogni utente puo' leggere/scrivere SOLO i propri dati (profilo, sessioni, misure).
// - Il campo "isTrainer" non puo' essere impostato dall'utente stesso (va attivato
//   manualmente da te, per il tuo account, direttamente da questa console:
//   Firestore Database → users → {tuo-uid} → aggiungi campo isTrainer = true).
// - Un utente con isTrainer:true puo' leggere tutti i profili e modificare
//   SOLO il campo "schedeAssegnate" degli altri utenti (per assegnare le schede),
//   nient'altro.
// - Il catalogo "schede" è leggibile da chiunque sia loggato; la creazione iniziale
//   (seed automatico al primissimo avvio dell'app) è permessa a qualunque utente
//   loggato, ma le modifiche successive sono permesse solo al trainer.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTrainer(){
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTrainer == true;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isTrainer());

      allow create: if request.auth != null && request.auth.uid == userId &&
        (!('isTrainer' in request.resource.data) || request.resource.data.isTrainer == false);

      allow update: if request.auth != null && (
        (request.auth.uid == userId &&
          request.resource.data.get('isTrainer', false) == resource.data.get('isTrainer', false)) ||
        (isTrainer() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schedeAssegnate']))
      );

      allow delete: if false;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /schede/{schedaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isTrainer();
    }
  }
}
